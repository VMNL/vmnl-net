# Names the module pages after the library, and removes the header pages and the links with generic names, like size.3,
# as they would clash with the pages of other packages.

file(GLOB pages LIST_DIRECTORIES false "${MAN_DIR}/*.3")
set(prefix "^(vmnl_net_|VMNL_NET_|VmnlNet)")
set(links "")
set(modules "")

foreach(page IN LISTS pages)
    get_filename_component(file "${page}" NAME)
    string(REGEX REPLACE "\\.3$" "" name "${file}")
    file(READ "${page}" content)
    if(content MATCHES "^\\.so ")
        if(name MATCHES "${prefix}")
            list(APPEND links "${page}")
        else()
            file(REMOVE "${page}")
        endif()
    elseif(name MATCHES "^[A-Z][A-Za-z]*$" AND NOT name MATCHES "${prefix}")
        list(APPEND modules "${name}")
    elseif(NOT name MATCHES "${prefix}")
        file(REMOVE "${page}")
    endif()
endforeach()

foreach(module IN LISTS modules)
    string(REGEX REPLACE "([a-z])([A-Z])" "\\1_\\2" snake "${module}")
    string(TOLOWER "vmnl_net_${snake}" renamed)
    foreach(link IN LISTS links)
        file(READ "${link}" content)
        string(REPLACE "man3/${module}.3" "man3/${renamed}.3" content "${content}")
        file(WRITE "${link}" "${content}")
    endforeach()
    file(READ "${MAN_DIR}/${module}.3" content)
    string(REPLACE ".TH \"${module}\"" ".TH \"${renamed}\"" content "${content}")
    string(REPLACE "\n${module} \\-" "\n${renamed} \\-" content "${content}")
    file(REMOVE "${MAN_DIR}/${module}.3")
    file(WRITE "${MAN_DIR}/${renamed}.3" "${content}")
endforeach()

file(GLOB pages LIST_DIRECTORIES false "${MAN_DIR}/*.3")
foreach(page IN LISTS pages)
    file(READ "${page}" content)
    if(content MATCHES "^\\.so man3/([^\n]+)" AND NOT EXISTS "${MAN_DIR}/${CMAKE_MATCH_1}")
        file(REMOVE "${page}")
    endif()
endforeach()
