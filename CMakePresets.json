{
  "version": 8,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "release",
      "displayName": "Build (Release)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VMNL_NET_BUILD_TESTS": "OFF",
        "VMNL_NET_BUILD_EXAMPLES": "OFF",
        "VMNL_NET_BUILD_BENCHMARKS": "OFF",
        "VMNL_NET_BUILD_DOCS": "OFF"
      }
    },
    {
      "name": "debug",
      "displayName": "Build (Debug)",
      "inherits": "release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "test",
      "displayName": "Test (Debug)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VMNL_NET_BUILD_TESTS": "ON",
        "VMNL_NET_BUILD_BENCHMARKS": "OFF",
        "VMNL_NET_BUILD_DOCS": "OFF"
      }
    },
    {
      "name": "coverage",
      "displayName": "Coverage (Debug)",
      "inherits": "test",
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "VMNL_NET_BUILD_EXAMPLES": "OFF",
        "CMAKE_C_FLAGS": "--coverage",
        "CMAKE_EXE_LINKER_FLAGS": "--coverage",
        "CMAKE_SHARED_LINKER_FLAGS": "--coverage"
      }
    },
    {
      "name": "sanitize",
      "displayName": "Sanitize (Debug)",
      "inherits": "test",
      "condition": {
        "type": "inList",
        "string": "${hostSystemName}",
        "list": ["Linux", "Darwin"]
      },
      "cacheVariables": {
        "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "bench",
      "displayName": "Benchmarks (Release)",
      "inherits": "release",
      "cacheVariables": {
        "VMNL_NET_BUILD_BENCHMARKS": "ON"
      }
    },
    {
      "name": "docs",
      "displayName": "Documentation",
      "inherits": "release",
      "cacheVariables": {
        "VMNL_NET_BUILD_DOCS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "displayName": "Build (Release)",
      "configurePreset": "release",
      "configuration": "Release"
    },
    {
      "name": "debug",
      "displayName": "Build (Debug)",
      "configurePreset": "debug",
      "configuration": "Debug"
    },
    {
      "name": "test",
      "displayName": "Test (Debug)",
      "configurePreset": "test",
      "configuration": "Debug"
    },
    {
      "name": "coverage",
      "displayName": "Coverage (Debug)",
      "configurePreset": "coverage",
      "configuration": "Debug"
    },
    {
      "name": "coverage-report",
      "displayName": "Coverage (report)",
      "configurePreset": "coverage",
      "configuration": "Debug",
      "targets": ["coverage"]
    },
    {
      "name": "sanitize",
      "displayName": "Sanitize (Debug)",
      "configurePreset": "sanitize",
      "configuration": "Debug"
    },
    {
      "name": "bench",
      "displayName": "Benchmarks (Release)",
      "configurePreset": "bench",
      "configuration": "Release"
    },
    {
      "name": "docs",
      "displayName": "Documentation",
      "configurePreset": "docs",
      "targets": ["docs"]
    },
    {
      "name": "format",
      "displayName": "Format",
      "configurePreset": "release",
      "targets": ["format"]
    },
    {
      "name": "format-check",
      "displayName": "Format (check)",
      "configurePreset": "release",
      "targets": ["format-check"]
    }
  ],
  "testPresets": [
    {
      "name": "test",
      "displayName": "Test (Debug)",
      "configurePreset": "test",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "coverage",
      "displayName": "Coverage (Debug)",
      "inherits": "test",
      "configurePreset": "coverage"
    },
    {
      "name": "sanitize",
      "displayName": "Sanitize (Debug)",
      "inherits": "test",
      "configurePreset": "sanitize"
    }
  ],
  "workflowPresets": [
    {
      "name": "release",
      "displayName": "Build (Release)",
      "steps": [
        { "type": "configure", "name": "release" },
        { "type": "build", "name": "release" }
      ]
    },
    {
      "name": "debug",
      "displayName": "Build (Debug)",
      "steps": [
        { "type": "configure", "name": "debug" },
        { "type": "build", "name": "debug" }
      ]
    },
    {
      "name": "test",
      "displayName": "Test (Debug)",
      "steps": [
        { "type": "configure", "name": "test" },
        { "type": "build", "name": "test" },
        { "type": "test", "name": "test" }
      ]
    },
    {
      "name": "coverage",
      "displayName": "Coverage (Debug)",
      "steps": [
        { "type": "configure", "name": "coverage" },
        { "type": "build", "name": "coverage" },
        { "type": "test", "name": "coverage" },
        { "type": "build", "name": "coverage-report" }
      ]
    },
    {
      "name": "sanitize",
      "displayName": "Sanitize (Debug)",
      "steps": [
        { "type": "configure", "name": "sanitize" },
        { "type": "build", "name": "sanitize" },
        { "type": "test", "name": "sanitize" }
      ]
    },
    {
      "name": "bench",
      "displayName": "Benchmarks (Release)",
      "steps": [
        { "type": "configure", "name": "bench" },
        { "type": "build", "name": "bench" }
      ]
    },
    {
      "name": "docs",
      "displayName": "Documentation",
      "steps": [
        { "type": "configure", "name": "docs" },
        { "type": "build", "name": "docs" }
      ]
    },
    {
      "name": "format",
      "displayName": "Format",
      "steps": [
        { "type": "configure", "name": "release" },
        { "type": "build", "name": "format" }
      ]
    },
    {
      "name": "format-check",
      "displayName": "Format (check)",
      "steps": [
        { "type": "configure", "name": "release" },
        { "type": "build", "name": "format-check" }
      ]
    }
  ]
}
