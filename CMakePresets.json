{
  "version": 8,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "VMNL_NET_BUILD_TESTS": "OFF",
        "VMNL_NET_BUILD_EXAMPLES": "OFF",
        "VMNL_NET_WARNINGS_AS_ERRORS": "$env{VMNL_NET_WARNINGS_AS_ERRORS}"
      }
    },
    {
      "name": "unix",
      "hidden": true,
      "condition": {
        "type": "inList",
        "string": "${hostSystemName}",
        "list": ["Linux", "Darwin"]
      }
    },
    {
      "name": "release",
      "displayName": "Build (Release)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "debug",
      "displayName": "Build (Debug)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "test",
      "displayName": "Test (Release)",
      "inherits": "release",
      "cacheVariables": {
        "VMNL_NET_BUILD_TESTS": "ON",
        "VMNL_NET_BUILD_EXAMPLES": "ON"
      }
    },
    {
      "name": "coverage",
      "displayName": "Coverage (Debug)",
      "inherits": ["test", "unix"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VMNL_NET_BUILD_EXAMPLES": "OFF",
        "CMAKE_C_FLAGS": "--coverage",
        "CMAKE_EXE_LINKER_FLAGS": "--coverage",
        "CMAKE_SHARED_LINKER_FLAGS": "--coverage"
      }
    },
    {
      "name": "mutation",
      "displayName": "Mutation (Debug)",
      "inherits": ["test", "unix"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VMNL_NET_BUILD_EXAMPLES": "OFF",
        "CMAKE_C_FLAGS": "-fpass-plugin=$env{MULL_PLUGIN} -g -grecord-command-line"
      }
    },
    {
      "name": "sanitize-address",
      "displayName": "Sanitize address (RelWithDebInfo)",
      "inherits": ["test", "unix"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "sanitize-memory",
      "displayName": "Sanitize memory (RelWithDebInfo)",
      "inherits": "test",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_C_FLAGS": "-fsanitize=memory -fsanitize-memory-track-origins -fno-sanitize-recover=all -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=memory",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=memory"
      }
    },
    {
      "name": "bench",
      "displayName": "Benchmarks (Release)",
      "inherits": "release",
      "cacheVariables": {
        "VMNL_NET_BUILD_BENCHMARKS": "ON"
      }
    },
    {
      "name": "docs",
      "displayName": "Documentation",
      "inherits": "release",
      "cacheVariables": {
        "VMNL_NET_BUILD_DOCS": "ON"
      }
    },
    {
      "name": "docs-internal",
      "displayName": "Documentation (internal)",
      "inherits": "docs",
      "cacheVariables": {
        "VMNL_NET_BUILD_DOCS_INTERNAL": "ON"
      }
    },
    {
      "name": "tidy",
      "displayName": "Static analysis",
      "inherits": "release",
      "generator": "Ninja",
      "cacheVariables": {
        "VMNL_NET_CLANG_TIDY": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "displayName": "Build (Release)",
      "configurePreset": "release",
      "configuration": "Release"
    },
    {
      "name": "debug",
      "displayName": "Build (Debug)",
      "configurePreset": "debug",
      "configuration": "Debug"
    },
    {
      "name": "test",
      "displayName": "Test (Release)",
      "configurePreset": "test",
      "configuration": "Release"
    },
    {
      "name": "coverage",
      "displayName": "Coverage (Debug)",
      "configurePreset": "coverage",
      "configuration": "Debug"
    },
    {
      "name": "coverage-report",
      "displayName": "Coverage (report)",
      "configurePreset": "coverage",
      "configuration": "Debug",
      "targets": ["coverage"]
    },
    {
      "name": "mutation",
      "displayName": "Mutation (Debug)",
      "configurePreset": "mutation",
      "configuration": "Debug"
    },
    {
      "name": "mutation-report",
      "displayName": "Mutation (report)",
      "configurePreset": "mutation",
      "configuration": "Debug",
      "targets": ["mutation"]
    },
    {
      "name": "sanitize-address",
      "displayName": "Sanitize address (RelWithDebInfo)",
      "configurePreset": "sanitize-address",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "sanitize-memory",
      "displayName": "Sanitize memory (RelWithDebInfo)",
      "configurePreset": "sanitize-memory",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "bench",
      "displayName": "Benchmarks (Release)",
      "configurePreset": "bench",
      "configuration": "Release"
    },
    {
      "name": "docs",
      "displayName": "Documentation",
      "configurePreset": "docs",
      "targets": ["docs"]
    },
    {
      "name": "docs-internal",
      "displayName": "Documentation (internal)",
      "configurePreset": "docs-internal",
      "targets": ["docs"]
    },
    {
      "name": "man",
      "displayName": "Man pages",
      "configurePreset": "docs",
      "targets": ["man"]
    },
    {
      "name": "format",
      "displayName": "Format",
      "configurePreset": "release",
      "targets": ["format"]
    },
    {
      "name": "format-check",
      "displayName": "Format (check)",
      "configurePreset": "release",
      "targets": ["format-check"]
    },
    {
      "name": "tidy",
      "displayName": "Static analysis",
      "configurePreset": "tidy",
      "nativeToolOptions": ["-k", "0"]
    }
  ],
  "testPresets": [
    {
      "name": "test",
      "displayName": "Test (Release)",
      "configurePreset": "test",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "coverage",
      "displayName": "Coverage (Debug)",
      "inherits": "test",
      "configurePreset": "coverage",
      "configuration": "Debug"
    },
    {
      "name": "sanitize-address",
      "displayName": "Sanitize address (RelWithDebInfo)",
      "inherits": "test",
      "configurePreset": "sanitize-address",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "sanitize-memory",
      "displayName": "Sanitize memory (RelWithDebInfo)",
      "inherits": "test",
      "configurePreset": "sanitize-memory",
      "configuration": "RelWithDebInfo"
    }
  ],
  "workflowPresets": [
    {
      "name": "release",
      "displayName": "Build (Release)",
      "steps": [
        { "type": "configure", "name": "release" },
        { "type": "build", "name": "release" }
      ]
    },
    {
      "name": "debug",
      "displayName": "Build (Debug)",
      "steps": [
        { "type": "configure", "name": "debug" },
        { "type": "build", "name": "debug" }
      ]
    },
    {
      "name": "test",
      "displayName": "Test (Release)",
      "steps": [
        { "type": "configure", "name": "test" },
        { "type": "build", "name": "test" },
        { "type": "test", "name": "test" }
      ]
    },
    {
      "name": "coverage",
      "displayName": "Coverage (Debug)",
      "steps": [
        { "type": "configure", "name": "coverage" },
        { "type": "build", "name": "coverage" },
        { "type": "test", "name": "coverage" },
        { "type": "build", "name": "coverage-report" }
      ]
    },
    {
      "name": "mutation",
      "displayName": "Mutation (Debug)",
      "steps": [
        { "type": "configure", "name": "mutation" },
        { "type": "build", "name": "mutation" },
        { "type": "build", "name": "mutation-report" }
      ]
    },
    {
      "name": "sanitize-address",
      "displayName": "Sanitize address (RelWithDebInfo)",
      "steps": [
        { "type": "configure", "name": "sanitize-address" },
        { "type": "build", "name": "sanitize-address" },
        { "type": "test", "name": "sanitize-address" }
      ]
    },
    {
      "name": "sanitize-memory",
      "displayName": "Sanitize memory (RelWithDebInfo)",
      "steps": [
        { "type": "configure", "name": "sanitize-memory" },
        { "type": "build", "name": "sanitize-memory" },
        { "type": "test", "name": "sanitize-memory" }
      ]
    },
    {
      "name": "bench",
      "displayName": "Benchmarks (Release)",
      "steps": [
        { "type": "configure", "name": "bench" },
        { "type": "build", "name": "bench" }
      ]
    },
    {
      "name": "docs",
      "displayName": "Documentation",
      "steps": [
        { "type": "configure", "name": "docs" },
        { "type": "build", "name": "docs" }
      ]
    },
    {
      "name": "docs-internal",
      "displayName": "Documentation (internal)",
      "steps": [
        { "type": "configure", "name": "docs-internal" },
        { "type": "build", "name": "docs-internal" }
      ]
    },
    {
      "name": "format",
      "displayName": "Format",
      "steps": [
        { "type": "configure", "name": "release" },
        { "type": "build", "name": "format" }
      ]
    },
    {
      "name": "format-check",
      "displayName": "Format (check)",
      "steps": [
        { "type": "configure", "name": "release" },
        { "type": "build", "name": "format-check" }
      ]
    },
    {
      "name": "tidy",
      "displayName": "Static analysis",
      "steps": [
        { "type": "configure", "name": "tidy" },
        { "type": "build", "name": "tidy" }
      ]
    }
  ]
}
