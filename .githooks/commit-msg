#!/bin/sh
# Checks the commit message with the convention checker of VMNL.

set -eu

CHECKER=$(mktemp)

readonly CHECKER

trap 'rm -f "$CHECKER"' EXIT

if ! curl -fsSL --max-time 5 -o "$CHECKER" https://raw.githubusercontent.com/VMNL/vmnl-graphics/main/tools/commit_message.py; then
    echo "commit-msg: cannot fetch the convention checker" >&2
    exit 1
fi

python3 "$CHECKER" file "$1"
