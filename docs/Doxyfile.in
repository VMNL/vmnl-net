PROJECT_NAME            = "VMNL / Network@VMNL_NET_DOCS_TITLE_SUFFIX@"
PROJECT_NUMBER          = @PROJECT_VERSION@
PROJECT_BRIEF           = "@PROJECT_DESCRIPTION@"
PROJECT_LOGO            = docs/logo.png
PROJECT_ICON            = docs/logo.png
OUTPUT_DIRECTORY        = @PROJECT_BINARY_DIR@/docs
INPUT                   = README.md CONTRIBUTING.md .github/CODE_OF_CONDUCT.md include/vmnl docs @VMNL_NET_DOCS_EXTRA_INPUT@
FILE_PATTERNS           = *.h *.md *.dox
RECURSIVE               = YES
EXAMPLE_PATH            = examples
LAYOUT_FILE             = docs/DoxygenLayout.xml
USE_MDFILE_AS_MAINPAGE  = README.md
MARKDOWN_ID_STYLE       = GITHUB
STRIP_FROM_PATH         = . include
STRIP_FROM_INC_PATH     = include
OPTIMIZE_OUTPUT_FOR_C   = YES
ENABLE_PREPROCESSING    = YES
MACRO_EXPANSION         = YES
EXPAND_ONLY_PREDEF      = YES
PREDEFINED              = VMNL_NET_API=
EXTRACT_ALL             = NO
EXTRACT_STATIC          = YES
SORT_MEMBER_DOCS        = NO
QUIET                   = YES
WARN_IF_UNDOCUMENTED    = YES
WARN_IF_DOC_ERROR       = YES
WARN_NO_PARAMDOC        = YES
WARN_AS_ERROR           = FAIL_ON_WARNINGS
GENERATE_HTML           = YES
GENERATE_LATEX          = NO
GENERATE_TREEVIEW       = YES
DISABLE_INDEX           = NO
FULL_SIDEBAR            = NO
HTML_COLORSTYLE         = LIGHT
HTML_EXTRA_STYLESHEET   = $(DOXYGEN_THEME) docs/vmnl.css
SEARCHENGINE            = YES
HAVE_DOT                = @VMNL_NET_DOCS_GRAPHS@
DOT_IMAGE_FORMAT        = svg
UML_LOOK                = YES
DOT_UML_DETAILS         = YES
UML_LIMIT_NUM_FIELDS    = 0
DOT_WRAP_THRESHOLD      = 40
INTERACTIVE_SVG         = YES
